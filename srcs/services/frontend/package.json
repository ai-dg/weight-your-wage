{
  "name": "salary-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev -H 0.0.0.0 -p ${PORT:-3001}",
    "dev:pages": "npx wrangler pages dev cf-pages-assets --proxy ${PORT:-3001} --port ${WRANGLER_INTERNAL_PORT:-8788} --ip 0.0.0.0 --compatibility-date=2024-09-23",
    "dev:pages:docker": "npx wrangler pages dev cf-pages-assets --proxy ${PORT:-3001} --port ${WRANGLER_INTERNAL_PORT:-8788} --ip 0.0.0.0 --compatibility-date=2024-09-23",
    "dev": "NEXT_PUBLIC_PREDICT_URL=/predict npx concurrently -k \"npm run dev:next\" \"npm run dev:pages\"",
    "dev:docker": "NEXT_PUBLIC_PREDICT_URL=/predict npx concurrently \"npm run dev:next\" \"npm run dev:pages:docker\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3001}",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "wrangler": "^4.77.0"
  }
}
